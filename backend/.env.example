# --- Database ---
# Postgres for staging/production (matches the brief's tech stack), e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/wakaless
# Left unset, the app falls back to a local SQLite file so it runs with zero setup.
DATABASE_URL=sqlite:///./wakaless.db

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Business rules (open decisions from the brief, change anytime, no code changes needed) ---
# One-time fee for a landlord's 2nd+ listing (first listing is free).
ADDITIONAL_LISTING_FEE_NGN=5000
# Days a live listing stays active before it needs the landlord to confirm it's still available.
LISTING_EXPIRY_DAYS=30
# Rent durations a landlord can choose from when creating a listing (months, comma-separated).
RENT_DURATION_OPTIONS_MONTHS=6,12,24
# Commission kept from each rent payment before the rest is manually paid to the landlord.
COMMISSION_LOW_NGN=20000
COMMISSION_HIGH_NGN=50000
COMMISSION_THRESHOLD_NGN=500000
# Renewal reminder lead times (days before a tenancy's end_date) and how often the check runs.
REMINDER_LEAD_DAYS_1=30
REMINDER_LEAD_DAYS_2=14
REMINDER_CHECK_INTERVAL_HOURS=24

# --- Payments ---
# One of: mock, paystack
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Notifications ---
# Email: one of mock, resend, zeptomail. SMS: one of mock, termii.
# Defaults to mock so the availability-confirmation + renewal-reminder flows work locally with no provider account.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=noreply@wakaless.local
NOTIFICATIONS_FROM_NAME=Wakaless
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_SMTP_USER=
ZEPTOMAIL_SMTP_PASSWORD=
SMS_PROVIDER=mock
TERMII_API_KEY=
TERMII_SENDER_ID=Wakaless

# Email verification / password reset codes: lifetime (minutes) and max wrong guesses.
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=15
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5

# --- File storage ---
# One of: local, cloudinary
STORAGE_PROVIDER=local
CLOUDINARY_URL=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Admin inbox ---
# Emailed whenever a landlord submits proof of ownership for review. Leave
# blank to skip this notification (the request still lands in the admin queue).
ADMIN_EMAIL=